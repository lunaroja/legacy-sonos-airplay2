+/* Private transactional SPTS-v2 FIFO writer.
+ * Owns fd after successful initialization. No retry/reopen after poison.
+ * Compile with -pthread. Caller retains original, unmodified AirPlay PTS.
+ */
+#ifndef PTS_TRANSACTION_WRITER_H
+#define PTS_TRANSACTION_WRITER_H
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/uio.h>
+#include <time.h>
+#include <unistd.h>
+
+#define SPW_DEFAULT_WAIT_NS UINT64_C(50000000)
+#define SPW_MAX_WAIT_NS UINT64_C(250000000)
+#define SPW_PRESENTATION_GUARD_NS UINT64_C(20000000)
+
+enum spw_failure {
+  SPW_OK, SPW_INVALID, SPW_POISONED, SPW_LOCK_TIMEOUT, SPW_DEADLINE,
+  SPW_PEER_CLOSED, SPW_IO_ERROR, SPW_CANCELLED
+};
+
+struct spw {
+  pthread_mutex_t mutex;
+  int fd;
+  int poisoned;
+  enum spw_failure failure;
+  size_t bytes_in_failed_record; /* metadata only, never source PCM */
+  size_t transaction_bytes;
+  long pipe_buf;
+};
+
+static uint64_t spw_now(void) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (uint64_t)ts.tv_sec * UINT64_C(1000000000) + (uint64_t)ts.tv_nsec;
+}
+
+/* Caller supplies now_raw from the SAME source clock as target_raw and a
+ * close bracketing MONOTONIC reading. Conservatively subtract measured bracket
+ * uncertainty from available lead. No changes to the wire PTS are made.
+ * Timed data: min(wait cap, real presentation lead minus guard/uncertainty).
+ * Control/untimed data: fixed wait cap, no fictitious presentation deadline.
+ */
+static uint64_t spw_deadline(uint64_t now_mono, uint64_t now_raw,
+                             uint64_t target_raw, int timed,
+                             uint64_t cap_ns, uint64_t uncertainty_ns) {
+  if (!cap_ns || cap_ns > SPW_MAX_WAIT_NS) return 0;
+  uint64_t allowance = cap_ns;
+  if (timed) {
+    if (uncertainty_ns > UINT64_MAX - SPW_PRESENTATION_GUARD_NS) return 0;
+    uint64_t margin = SPW_PRESENTATION_GUARD_NS + uncertainty_ns;
+    if (target_raw <= now_raw || target_raw - now_raw <= margin) return 0;
+    uint64_t available = target_raw - now_raw - margin;
+    if (available < allowance) allowance = available;
+  }
+  if (now_mono > UINT64_MAX - allowance) return 0;
+  return now_mono + allowance;
+}
+
+static int spw_init(struct spw *w, int fd) {
+  struct stat st;
+  if (fstat(fd, &st) < 0 || !S_ISFIFO(st.st_mode)) return -1;
+  long bound = fpathconf(fd, _PC_PIPE_BUF);
+  if (bound <= 0) return -1;
+  int flags = fcntl(fd, F_GETFL);
+  if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) return -1;
+  memset(w, 0, sizeof(*w));
+  int result = pthread_mutex_init(&w->mutex, NULL);
+  if (result != 0) { errno = result; return -1; }
+  w->fd = fd;
+  w->pipe_buf = bound;
+  return 0;
+}
+
+/* Must hold mutex. Once a transaction fails/cancels, no STOP/FLUSH/audio can
+ * follow it. Closing the only owned write fd makes the reader see EOF after
+ * any buffered bytes; restoration requires a fresh writer/epoch externally.
+ */
+static void spw_poison_locked(struct spw *w, enum spw_failure failure) {
+  if (!w->poisoned) {
+    w->poisoned = 1;
+    w->failure = failure;
+    w->bytes_in_failed_record = w->transaction_bytes;
+    if (w->fd >= 0) close(w->fd);
+    w->fd = -1;
+  }
+}
+
+static void spw_cancel_cleanup(void *arg) {
+  struct spw *w = arg;
+  spw_poison_locked(w, SPW_CANCELLED);
+  pthread_mutex_unlock(&w->mutex);
+}
+
+static void spw_put(uint8_t *p, uint64_t value, unsigned count) {
+  for (unsigned i = 0; i < count; ++i)
+    p[count - i - 1] = (uint8_t)(value >> (8 * i));
+}
+
+/* The caller must block/ignore SIGPIPE before using this pipe API (as the
+ * current receiver does), otherwise OS default termination precedes EPIPE.
+ * Deadline is absolute MONOTONIC and <=250ms from entry, not a renewed timeout
+ * per retry. Large records are never replayed after partial progress.
+ */
+static enum spw_failure spw_send_until(struct spw *w, unsigned kind,
+    uint32_t epoch, uint32_t sequence, uint64_t pts, uint64_t observed,
+    uint32_t frames, uint32_t rtp, const void *pcm, uint64_t deadline) {
+  uint64_t entry = spw_now();
+  if (!deadline || deadline <= entry || deadline - entry > SPW_MAX_WAIT_NS)
+    return SPW_INVALID;
+  int old_cancel;
+  pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &old_cancel);
+  for (;;) {
+    int locked = pthread_mutex_trylock(&w->mutex);
+    if (locked == 0) break;
+    if (locked != EBUSY) {
+      pthread_setcancelstate(old_cancel, NULL);
+      return SPW_IO_ERROR;
+    }
+    if (spw_now() >= deadline) {
+      pthread_setcancelstate(old_cancel, NULL);
+      return SPW_LOCK_TIMEOUT;
+    }
+    pthread_setcancelstate(old_cancel, NULL);
+    struct timespec pause = {.tv_sec = 0, .tv_nsec = 1000000};
+    nanosleep(&pause, NULL);
+    pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, NULL);
+  }
+  enum spw_failure result = SPW_OK;
+  w->transaction_bytes = 0;
+  pthread_cleanup_push(spw_cancel_cleanup, w);
+  pthread_setcancelstate(old_cancel, NULL);
+  pthread_testcancel();
+  if (w->poisoned || w->fd < 0) {
+    result = SPW_POISONED;
+  } else if (kind < 1 || kind > 4 || frames > 8192 ||
+             (kind == 1 && (!frames || !pts || !pcm)) ||
+             (kind == 2 && frames && !pcm) || (kind >= 3 && frames)) {
+    result = SPW_INVALID;
+    spw_poison_locked(w, result);
+  } else {
+    uint8_t header[40] = {'S','P','T','S',2,(uint8_t)kind,0,4};
+    spw_put(header + 8, epoch, 4); spw_put(header + 12, sequence, 4);
+    spw_put(header + 16, pts, 8); spw_put(header + 24, observed, 8);
+    spw_put(header + 32, frames, 4); spw_put(header + 36, rtp, 4);
+    struct iovec vec[2] = {{header, sizeof(header)}, {(void *)pcm, (size_t)frames * 4}};
+    int count = kind <= 2 && frames ? 2 : 1;
+    int index = 0;
+    while (index < count) {
+      pthread_testcancel();
+      uint64_t now = spw_now();
+      if (now >= deadline) { result = SPW_DEADLINE; break; }
+      /* One writev for header + payload: <=PIPE_BUF is atomic on a pipe. */
+      ssize_t written = writev(w->fd, vec + index, count - index);
+      if (written > 0) {
+        w->transaction_bytes += (size_t)written;
+        size_t advance = (size_t)written;
+        while (index < count && advance >= vec[index].iov_len) {
+          advance -= vec[index].iov_len;
+          ++index;
+        }
+        if (index < count && advance) {
+          vec[index].iov_base = (uint8_t *)vec[index].iov_base + advance;
+          vec[index].iov_len -= advance;
+        }
+        continue;
+      }
+      if (written < 0 && errno == EINTR) continue;
+      if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        now = spw_now();
+        if (now >= deadline) { result = SPW_DEADLINE; break; }
+        uint64_t left = deadline - now;
+        int ms = left < UINT64_C(5000000) ? (int)((left + 999999) / 1000000) : 5;
+        struct pollfd poll_fd = {.fd = w->fd, .events = POLLOUT};
+        int ready = poll(&poll_fd, 1, ms);
+        if (ready < 0 && errno == EINTR) continue;
+        if (ready < 0) { result = SPW_IO_ERROR; break; }
+        if (ready > 0 && (poll_fd.revents & (POLLERR | POLLHUP | POLLNVAL))) {
+          result = SPW_PEER_CLOSED; break;
+        }
+        continue;
+      }
+      result = written < 0 && errno == EPIPE ? SPW_PEER_CLOSED : SPW_IO_ERROR;
+      break;
+    }
+    if (result != SPW_OK) spw_poison_locked(w, result);
+  }
+  /* No cancellation window between removing cleanup and unlocking. */
+  pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, NULL);
+  pthread_cleanup_pop(0);
+  pthread_mutex_unlock(&w->mutex);
+  pthread_setcancelstate(old_cancel, NULL);
+  return result;
+}
+
+/* Only after all producer threads have joined; destruction is not a signal
+ * handler and does not emit STOP. A caller must send STOP successfully first
+ * when the normal lifecycle requires it. */
+static void spw_destroy(struct spw *w) {
+  if (w->fd >= 0) close(w->fd);
+  w->fd = -1;
+  pthread_mutex_destroy(&w->mutex);
+}
