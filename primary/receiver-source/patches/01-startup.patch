+#ifndef SPTS_TIMING_H
+#define SPTS_TIMING_H
+#include <stdint.h>
+#include <string.h>
+#include <limits.h>
+
+enum { SPTS_INITIAL=1, SPTS_ANCHOR=2, SPTS_OFFSET=4, SPTS_MASTER=8,
+       SPTS_RECOVERY=16, SPTS_RATE=32 };
+typedef struct {
+  uint64_t generation, anchor_frame, anchor_raw_ns, frame, pts_raw_ns, trim_ns;
+  uint32_t input_rate, flags;
+} spts_timing;
+
+typedef struct {
+  uint64_t generation, clock_id, anchor_frame, remote_ns, offset;
+  uint32_t rate, flags;
+  int seen, invalid;
+} spts_map_state;
+
+static inline int spts_project(uint64_t frame, uint64_t anchor,
+                               uint64_t anchor_ns, uint32_t rate,
+                               uint64_t *result) {
+  if (!rate) return -1;
+  int64_t difference = (int64_t)(frame - anchor);
+  __int128 projected = (__int128)anchor_ns + (__int128)difference * 1000000000 / rate;
+  if (projected <= 0 || projected > UINT64_MAX) return -1;
+  *result = (uint64_t)projected;
+  return 0;
+}
+
+/* Call with the native reference_time_mutex held. All arguments come from
+ * the same successful native PTP lookup, never from inferred output deltas. */
+static inline int spts_capture(spts_map_state *state, uint64_t clock_id,
+    uint64_t anchor, uint64_t remote_ns, uint64_t offset, uint32_t rate,
+    uint64_t frame, spts_timing *out) {
+  if (rate != 44100 && rate != 48000) return -1;
+  uint32_t flags = 0;
+  if (!state->seen) flags |= SPTS_INITIAL;
+  else {
+    if (state->anchor_frame != anchor || state->remote_ns != remote_ns) flags |= SPTS_ANCHOR;
+    if (state->offset != offset) flags |= SPTS_OFFSET;
+    if (state->clock_id != clock_id) flags |= SPTS_MASTER;
+    if (state->rate != rate) flags |= SPTS_RATE;
+    if (state->invalid) flags |= SPTS_RECOVERY;
+  }
+  if (flags) {
+    if (state->generation == UINT64_MAX) return -1;
+    ++state->generation;
+    state->flags = flags;
+  }
+  /* Native clock offsets are modulo-2^64 signed differences. Preserve the
+   * same subtraction as rtp.c; the resulting local time must project validly. */
+  uint64_t anchor_ns = remote_ns - offset;
+  uint64_t pts;
+  if (spts_project(frame, anchor, anchor_ns, rate, &pts)) return -1;
+  *out = (spts_timing){.generation=state->generation, .anchor_frame=anchor,
+    .anchor_raw_ns=anchor_ns, .frame=frame, .pts_raw_ns=pts,
+    .input_rate=rate, .flags=state->flags};
+  state->clock_id=clock_id; state->anchor_frame=anchor; state->remote_ns=remote_ns;
+  state->offset=offset; state->rate=rate; state->seen=1; state->invalid=0;
+  return 0;
+}
+
+typedef struct {
+  spts_timing previous;
+  uint64_t window_frame, window_pts, window_trim;
+  int seen;
+} spts_gate;
+
+static inline void spts_gate_reset(spts_gate *gate) { memset(gate, 0, sizeof(*gate)); }
+
+/* Preview only. Commit the returned next state AFTER complete FLUSH+TIMED
+ * writes. Return 1 for an ordered boundary, 0 for continuity, -1 for invalid
+ * or unproven timing. This is private adapter policy, not an AirPlay limit. */
+static inline int spts_gate_preview(const spts_gate *gate, const spts_timing *now,
+                                    spts_gate *next, int64_t *delta_out) {
+  if (!now->generation || (now->input_rate != 44100 && now->input_rate != 48000)) return -1;
+  uint64_t exact;
+  if (spts_project(now->frame, now->anchor_frame, now->anchor_raw_ns, now->input_rate, &exact)
+      || exact > UINT64_MAX-now->trim_ns || exact+now->trim_ns != now->pts_raw_ns) return -1;
+  int boundary=0;
+  int64_t delta=0;
+  if (gate->seen) {
+    const spts_timing *old=&gate->previous;
+    if (now->generation < old->generation) return -1;
+    int changed = now->anchor_frame != old->anchor_frame || now->anchor_raw_ns != old->anchor_raw_ns
+                  || now->input_rate != old->input_rate;
+    if (changed && (now->generation == old->generation || !now->flags)) return -1;
+    int rate_changed = now->input_rate != old->input_rate;
+    if (!rate_changed && (int64_t)(now->frame-old->frame) <= 0) return -1;
+    uint64_t old_projection;
+    if (spts_project(now->frame, old->anchor_frame, old->anchor_raw_ns, old->input_rate, &old_projection)
+        || old_projection > UINT64_MAX-now->trim_ns) return -1;
+    delta=(int64_t)(now->pts_raw_ns-(old_projection+now->trim_ns));
+    uint64_t window_projection;
+    if (gate->window_pts < gate->window_trim ||
+        spts_project(now->frame, gate->window_frame, gate->window_pts-gate->window_trim,
+                     old->input_rate, &window_projection) || window_projection > UINT64_MAX-now->trim_ns) return -1;
+    int64_t rolling=(int64_t)(now->pts_raw_ns-(window_projection+now->trim_ns));
+    int new_revision=now->generation != old->generation;
+    boundary = rate_changed || (new_revision && (now->flags & (SPTS_MASTER|SPTS_RECOVERY|SPTS_RATE)))
+      || delta > 1000000 || delta < -1000000 || rolling > 2000000 || rolling < -2000000
+      || now->pts_raw_ns <= old->pts_raw_ns;
+    if (boundary && (!new_revision || !now->flags)) return -1;
+  }
+  *next=*gate;
+  if (!gate->seen || boundary || now->pts_raw_ns-gate->window_pts >= UINT64_C(1000000000)) {
+    next->window_frame=now->frame; next->window_pts=now->pts_raw_ns; next->window_trim=now->trim_ns;
+  }
+  next->seen=1; next->previous=*now;
+  *delta_out=delta;
+  return boundary;
+}
+#endif
