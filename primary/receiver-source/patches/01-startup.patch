+#include "spts_diag.h"
+#include "utilities/debug.h"
+#include <pthread.h>
+#include <string.h>
+#include <time.h>
+#include <inttypes.h>
+#define SPD_EVENTS 256
+#define SPD_SECONDS 180
+#define SPD_MAX_REPORTS 192
+_Atomic int spdiag_enabled;
+_Atomic uint64_t spdiag_counts[SPD_COUNT];
+static _Atomic uint64_t events[SPD_EVENTS], event_reserved;
+static pthread_mutex_t report_mutex=PTHREAD_MUTEX_INITIALIZER;
+static pthread_t reporter;
+static int reporter_started;
+static unsigned emitted, reports;
+static const char *const methods[]={"OPTIONS","ANNOUNCE","FLUSH","TEARDOWN","SETUP","GET_PARAMETER","SET_PARAMETER","RECORD","GET","POST","SETPEERS","SETPEERSX","SETRATEANCHORTI","FLUSHBUFFERED","SETRATE"};
+static const char *const routes[]={"/info","/pair-setup","/pair-verify","/pair-add","/pair-remove","/pair-list","/pair-pin-start","/fp-setup","/configure","/feedback","/command","/audioMode"};
+/* 0: request/no response yet; 1..12 exact allowlisted response; 13: other. */
+static const int statuses[]={200,400,401,403,451,453,456,470,500,501,503,454};
+static unsigned token(const char *value,const char *const *table,unsigned count) {
+ if(!value || strnlen(value,64)==64)return 0;
+ for(unsigned i=0;i<count;i++)if(!strcmp(value,table[i]))return i+1;
+ return 0;
+}
+void spdiag_rtsp(const char *method,const char *path,int code,int stream,int write_failed) {
+ if(!atomic_load_explicit(&spdiag_enabled,memory_order_relaxed))return;
+ unsigned m=token(method,methods,sizeof(methods)/sizeof(*methods));
+ unsigned r=token(path,routes,sizeof(routes)/sizeof(*routes));
+ unsigned c=code==0?0:13;
+ for(unsigned i=0;i<sizeof(statuses)/sizeof(*statuses);i++)if(code==statuses[i])c=i+1;
+ /* stream is a fixed caller enum: 0 unknown, 1 classic, 2 realtime, 3 buffered. */
+ unsigned s=stream>=0&&stream<=3?(unsigned)stream:0;
+ uint64_t packed=UINT64_C(1)<<63 | m | (r<<8) | (c<<16) | (s<<24) | ((write_failed!=0)<<28);
+ uint64_t slot=atomic_fetch_add_explicit(&event_reserved,1,memory_order_relaxed);
+ if(slot<SPD_EVENTS)atomic_store_explicit(&events[slot],packed,memory_order_release);
+}
+static void unlock_report(void *v){pthread_mutex_unlock(v);}
+void spdiag_checkpoint(void) {
+ if(!reporter_started || pthread_mutex_trylock(&report_mutex))return;
+ pthread_cleanup_push(unlock_report,&report_mutex);
+ if(reports<SPD_MAX_REPORTS) {
+  unsigned tick=++reports;
+  for(unsigned budget=0;budget<SPD_EVENTS && emitted<SPD_EVENTS;budget++) {
+   uint64_t e=atomic_load_explicit(&events[emitted],memory_order_acquire);
+   if(!e)break;
+   inform("SPTS startup rtsp seq=%u method=%u route=%u status=%u stream=%u write_failed=%u",
+          ++emitted,(unsigned)(e&255),(unsigned)((e>>8)&255),(unsigned)((e>>16)&255),
+          (unsigned)((e>>24)&15),(unsigned)((e>>28)&1));
+  }
+  for(unsigned g=0;g<4;g++) {
+   uint64_t c[16];for(unsigned i=0;i<16;i++)c[i]=atomic_load_explicit(&spdiag_counts[g*16+i],memory_order_relaxed);
+   inform("SPTS startup counts tick=%u group=%u a=%" PRIu64 " b=%" PRIu64 " c=%" PRIu64 " d=%" PRIu64 " e=%" PRIu64 " f=%" PRIu64 " g=%" PRIu64 " h=%" PRIu64 " i=%" PRIu64 " j=%" PRIu64 " k=%" PRIu64 " l=%" PRIu64 " m=%" PRIu64 " n=%" PRIu64 " o=%" PRIu64 " p=%" PRIu64,
+          tick,g,c[0],c[1],c[2],c[3],c[4],c[5],c[6],c[7],c[8],c[9],c[10],c[11],c[12],c[13],c[14],c[15]);
+  }
+ }
+ pthread_cleanup_pop(1);
+}
+static void *report_main(void *unused) {
+ (void)unused;
+ for(unsigned i=0;i<SPD_SECONDS && atomic_load(&spdiag_enabled);i++) {
+  struct timespec t={1,0};nanosleep(&t,NULL);
+  spdiag_checkpoint();
+ }
+ atomic_store(&spdiag_enabled,0);
+ return NULL;
+}
+int spdiag_start(void) {
+ if(reporter_started)return 0;
+ /* Init is called once before RTSP threads. No reset/reallocation while active. */
+ atomic_store(&spdiag_enabled,1);reporter_started=1;
+ if(pthread_create(&reporter,NULL,report_main,NULL)) {
+  reporter_started=0;atomic_store(&spdiag_enabled,0);return -1;
+ }
+ inform("SPTS startup enabled window_s=180 event_limit=256 report_limit=192");
+ return 0;
+}
+void spdiag_end(void) {
+ if(!reporter_started)return;
+ atomic_store(&spdiag_enabled,0);pthread_join(reporter,NULL);
+ spdiag_checkpoint();reporter_started=0;
+}
