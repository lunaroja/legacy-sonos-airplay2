+/* Private SPTS v2 extension; raw pipe behavior remains selected by default. */
+enum { PTS_TIMED=1, PTS_UNTIMED=2, PTS_FLUSH=3, PTS_STOP=4 };
+static int timestamped_pipe = 0, timestamped_reanchor = 0;
+static int timestamped_write_timeout_ms = 50;
+static uint32_t pts_epoch = 0, pts_sequence = 0;
+static struct spw pts_writer;
+static int pts_writer_ready = 0, pts_started = 0;
+static spts_gate pts_gate;
+static pthread_mutex_t pts_order_mutex = PTHREAD_MUTEX_INITIALIZER;
+extern audio_output audio_pipe;
+
+static void pts_order_unlock(void *arg) { pthread_mutex_unlock(arg); }
+
+/* Called only under pts_order_mutex, including epoch/sequence allocation.
+ * A failed writer remains closed/poisoned; cleanup never appends a record. */
+static enum spw_failure emit_pts_locked(unsigned kind, uint32_t frames, uint32_t rtp,
+                                         uint64_t target, const void *pcm) {
+  if (!pts_writer_ready || pts_writer.poisoned) return SPW_POISONED;
+  if (pts_sequence == UINT32_MAX || (kind <= PTS_UNTIMED && !pts_started)) {
+    pthread_mutex_lock(&pts_writer.mutex);
+    spw_poison_locked(&pts_writer, SPW_INVALID);
+    pthread_mutex_unlock(&pts_writer.mutex);
+    return SPW_INVALID;
+  }
+  uint64_t before=spw_now(), observed=get_absolute_time_in_ns(), after=spw_now();
+  uint64_t deadline=spw_deadline(before, observed, target, kind==PTS_TIMED,
+      (uint64_t)timestamped_write_timeout_ms*1000000, after-before);
+  if (!deadline) {
+    pthread_mutex_lock(&pts_writer.mutex);
+    spw_poison_locked(&pts_writer, SPW_DEADLINE);
+    pthread_mutex_unlock(&pts_writer.mutex);
+    return SPW_DEADLINE;
+  }
+  enum spw_failure written=spw_send_until(&pts_writer, kind, pts_epoch, ++pts_sequence, target,
+                        observed, frames, rtp, pcm, deadline);
+  if (written==SPW_OK && kind<=PTS_UNTIMED) spdiag_bump(kind==PTS_TIMED?SPD_WIRE_TIMED_OK:SPD_WIRE_UNTIMED_OK,1);
+  return written;
+}
+
+static enum spw_failure pts_boundary_locked(void) {
+  if (pts_epoch == UINT32_MAX) {
+    pthread_mutex_lock(&pts_writer.mutex);
+    spw_poison_locked(&pts_writer, SPW_INVALID);
+    pthread_mutex_unlock(&pts_writer.mutex);
+    return SPW_INVALID;
+  }
+  ++pts_epoch;
+  spts_gate_reset(&pts_gate);
+  enum spw_failure result=emit_pts_locked(PTS_FLUSH, 0, 0, 0, NULL);
+  if (result==SPW_OK) pts_started=1;
+  return result;
+}
+
+static void pts_report_failure(enum spw_failure result) {
+  if (result != SPW_OK)
+    die("SPTS write failure code=%u bytes=%zu", (unsigned)result,
+        pts_writer_ready ? pts_writer.bytes_in_failed_record : 0);
+}
+
+static void pts_flush(void) {
+  spdiag_bump(SPD_PIPE_FLUSH,1);
+  if (!timestamped_pipe) return;
+  enum spw_failure result=SPW_OK;
+  pthread_mutex_lock(&pts_order_mutex);
+  pthread_cleanup_push(pts_order_unlock, &pts_order_mutex);
+  if (pts_writer_ready && !pts_writer.poisoned) result=pts_boundary_locked();
+  pthread_cleanup_pop(1);
+  pts_report_failure(result);
+}
+
+static int pts_prepare(void) {
+  enum spw_failure result=SPW_OK;
+  pthread_mutex_lock(&pts_order_mutex);
+  pthread_cleanup_push(pts_order_unlock, &pts_order_mutex);
+  if (!pts_writer_ready) {
+    int pipe_fd=try_to_open_pipe_for_writing(pipename);
+    if (pipe_fd < 0) result=SPW_PEER_CLOSED;
+    else if (spw_init(&pts_writer, pipe_fd) != 0) { close(pipe_fd); result=SPW_IO_ERROR; }
+    else pts_writer_ready=1;
+  }
+  if (result==SPW_OK) result=pts_writer.poisoned ? SPW_POISONED : pts_boundary_locked();
+  pthread_cleanup_pop(1);
+  pts_report_failure(result);
+  return result==SPW_OK ? 0 : -1;
+}
+
+static void emit_pts(unsigned kind, uint32_t frames, uint32_t rtp,
+                     uint64_t playtime, const void *pcm) {
+  int64_t raw_target=kind==PTS_TIMED ?
+      (int64_t)playtime-(int64_t)(config.audio_backend_latency_offset*1e9) : 0;
+  enum spw_failure result=SPW_INVALID;
+  pthread_mutex_lock(&pts_order_mutex);
+  pthread_cleanup_push(pts_order_unlock, &pts_order_mutex);
+  if (raw_target >= 0)
+    result=emit_pts_locked(kind, frames, rtp, (uint64_t)raw_target, pcm);
+  pthread_cleanup_pop(1);
+  pts_report_failure(result);
+}
+
+static int play_timed_with_provenance(void *buf, int samples, uint32_t rtp,
+                                      const spts_timing *timing) {
+  enum spw_failure result=SPW_INVALID;
+  int boundary=-1;
+  int64_t delta=0;
+  uint32_t emitted_epoch=0;
+  pthread_mutex_lock(&pts_order_mutex);
+  pthread_cleanup_push(pts_order_unlock, &pts_order_mutex);
+  spts_gate next;
+  if (samples>0 && bytes_per_frame==4 && timing != NULL)
+    boundary=spts_gate_preview(&pts_gate, timing, &next, &delta);
+  if (boundary>=0) {
+    result=boundary ? pts_boundary_locked() : SPW_OK;
+    if (result==SPW_OK) result=emit_pts_locked(PTS_TIMED, (uint32_t)samples, rtp,
+                                             timing->pts_raw_ns, buf);
+    if (result==SPW_OK) { pts_gate=next; emitted_epoch=pts_epoch; }
+  } else if (pts_writer_ready && !pts_writer.poisoned) {
+    pthread_mutex_lock(&pts_writer.mutex);
+    spw_poison_locked(&pts_writer, SPW_INVALID);
+    pthread_mutex_unlock(&pts_writer.mutex);
+  }
+  pthread_cleanup_pop(1);
+  pts_report_failure(result);
+  if (boundary>0 && result==SPW_OK)
+    inform("SPTS reanchor epoch=%u generation=%" PRIu64 " flags=%u delta_ns=%" PRId64,
+           emitted_epoch, timing->generation, timing->flags, delta);
+  return result==SPW_OK ? 0 : -1;
+}
